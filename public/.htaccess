Options -MultiViews

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

    # Home
    RewriteRule ^$ index.html [L]

    # Next.js static export generates both folders (e.g. /datenschutz/)
    # and flat HTML files (e.g. /datenschutz.html). When a folder exists,
    # Apache would otherwise treat /datenschutz as a directory. These rules
    # ensure clean URLs always resolve to the corresponding .html file.

    # If a directory is requested and a matching .html exists, serve it
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # If a file is requested without extension and matching .html exists, serve it
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Otherwise return a proper 404 (and let ErrorDocument render the page)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]

</IfModule>

ErrorDocument 404 /404.html
